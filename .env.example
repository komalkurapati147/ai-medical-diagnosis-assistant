# ---- App ----
APP_ENV=development
APP_NAME=AI Medical Diagnosis Assistant

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql://postgres:postgres@db:5432/medical_diagnosis

# ---- LLM Providers ----
LLM_PROVIDER=gemini              # gemini | openai
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ---- Model paths ----
MODEL_PATH=saved_models/xgboost_model.pkl
ENCODER_PATH=saved_models/label_encoder.pkl
FEATURES_PATH=saved_models/feature_columns.pkl

# ---- Reports ----
REPORTS_DIR=generated_reports
